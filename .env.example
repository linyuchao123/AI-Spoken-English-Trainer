# ============================================================
# AI英语口语陪练 — Environment Variables
# Copy this file to .env and fill in your API keys
# ============================================================

# --- OpenAI API (GPT-4o for dialogue, Whisper for ASR, TTS) ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- DeepSeek API (alternative LLM for dialogue) ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# --- Azure Speech Services (Pronunciation Assessment + TTS) ---
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_REGION=eastasia

# --- Model Selection ---
# Options: openai | deepseek
DEFAULT_MODEL=openai

# --- JWT Secret (change in production!) ---
JWT_SECRET_KEY=your-jwt-secret-change-in-production

# --- GitHub OAuth (for social login) ---
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Set Homepage URL to: http://localhost:3000
# Set Authorization callback URL to: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- Frontend URL (for OAuth redirect) ---
FRONTEND_URL=http://localhost:3000

# --- LangSmith (AI Observability & Tracing) ---
# Get your API key at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=ai-english-trainer
